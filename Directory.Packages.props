<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <!-- Fix GHSA-846f-f764-76mx: a SQL client dependency pulls vulnerable Pkcs 9.0.18. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
</Project>
