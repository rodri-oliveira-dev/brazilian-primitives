<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Brazilian.Primitives</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Immutable .NET value objects for validating and normalizing Brazilian domain identifiers such as CPF, CNPJ, CEP, Pix keys, phone numbers, vehicle records, and state-aware registrations.</Description>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../README.pt-BR.md" Pack="true" PackagePath="/" />
    <None Include="../../README.en.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
