<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Brazilian.PrimitivesTypes.EntityFrameworkCore.SqlServer</PackageId>
    <Title>Brazilian Primitives Types - Entity Framework Core SQL Server</Title>
    <Description>Entity Framework Core SQL Server integration for Brazilian.PrimitivesTypes. Provides conventions and value converters for persisting Brazilian value objects with provider-aware varchar mappings, including state-aware RG and InscricaoEstadual mappings.</Description>
    <PackageTags>brazil;brazilian;cpf;cnpj;cep;entity-framework-core;ef-core;sql-server;value-converters;value-objects;ddd;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <RootNamespace>Brazilian.PrimitivesTypes.EntityFrameworkCore.SqlServer</RootNamespace>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Brazilian.PrimitivesTypes/Brazilian.PrimitivesTypes.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="resource/nuget-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
